<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose drives theming at runtime. The Material3 base is the
         minimum Android needs to launch an Activity with the
         Compose-friendly default. -->
    <style name="Theme.FreecodeRemote" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">@color/ic_launcher_background</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>