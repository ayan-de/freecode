// Trajectory suite — did the right tool fire, with the right args, in a sane
// number of turns? Spec: docs/superpowers/specs/2026-08-23-eval-harness.md
//
// EVERY CASE IS READ-ONLY, and `dataset.ts` enforces it. Phase 1 has no
// sandbox (spec §6.1), so a case runs against the real working directory, and
// `forbidTools` only SCORES a mutation — by the time it reports "called
// forbidden write" the file is already written. Agent mode is the only thing
// that prevents it, so build/danger are refused at load. `bash` is not in
// READONLY_TOOLS, so bash cases wait for the sandbox too.
//
// Cases must be near-deterministic (p >= 0.99). A case that lands around 0.93
// is a BAD CASE, not a hard task — `freecode eval --quarantine-report` finds
// them. Needles are the shortest string that still distinguishes right from
// wrong: encoding one exact spelling tests the model's phrasing, not the harness.
//
// A DENIED tool call is invisible here. `loop.ts` returns on a mode/rule deny
// BEFORE `recordFunctionCall`, so no `function.call`/`function.output` pair is
// written and `buildTrace` never makes a span for it. On a read-only-mode case
// `forbidTools` therefore stays silent while enforcement works, and only fires
// if enforcement breaks and the edit really executes — which is the regression
// it exists to catch, but it means forbidTools alone asserts nothing about the
// model. Pair it with an `expectTool` that proves the work happened, or the
// case passes an agent that did nothing at all.
//
// `expectMaxTurns` is a proxy for verbosity, not correctness. Don't put one on
// a case whose prompt fights the mode: refused the edit it was asked for, a
// model spends its turns reading and explaining, which is the right behaviour
// scored as a failure.
{"id": "find-symbol-uses-grep", "prompt": "Where is HANG_THRESHOLD_MS defined in this repo? Just tell me the file.", "expectTool": "grep", "expectInArgs": {"pattern": "HANG_THRESHOLD"}, "expectMaxTurns": 4, "forbidTools": ["write", "edit"]}
{"id": "read-named-file", "prompt": "Read apps/core/src/rollout/types.ts and tell me how many event types RolloutEvent has.", "expectTool": "read", "expectInArgs": {"filePath": "rollout/types.ts"}, "expectMaxTurns": 4, "forbidTools": ["write", "edit"]}
{"id": "glob-by-extension", "prompt": "List every .test.ts file under apps/core/src/rollout using a glob pattern.", "expectTool": "glob", "expectMaxTurns": 4, "forbidTools": ["write", "edit"]}
{"id": "ls-a-directory", "prompt": "What files are in apps/core/src/eval? List the directory.", "expectTool": "ls", "expectMaxTurns": 3, "forbidTools": ["write", "edit"]}
{"id": "no-tool-for-general-knowledge", "prompt": "In one sentence and without using any tools, what does the acronym JSONL stand for?", "expectTool": null, "expectMaxTurns": 2}
{"id": "no-tool-for-arithmetic", "prompt": "Without using any tools, what is 17 * 23? Answer with just the number.", "expectTool": null, "expectMaxTurns": 2}
{"id": "no-tool-for-definition", "prompt": "Without using any tools, in one sentence: what is a git worktree?", "expectTool": null, "expectMaxTurns": 2}
