// Redirect suite — cases built to make the agent go in circles, so that
// trajectory redirection has something to redirect.
// Spec: docs/superpowers/specs/2026-08-26-trajectory-redirection.md §9.
//
// Run it BOTH WAYS and compare — the suite on its own says nothing:
//   freecode eval redirect --trials 5 --save /tmp/off.json      # redirect.enabled=false
//   freecode eval redirect --trials 5 --compare /tmp/off.json --stuck
//
// The metric that matters is `repeated calls`, not pass rate: these prompts are
// deliberately unanswerable or near-unanswerable, so a "pass" mostly means the
// agent gave up in a bounded number of turns instead of grinding. What
// redirection has to prove is that it grinds LESS.
//
// MEASURED 2026-08-27, and the result is that this suite CANNOT currently
// exercise the feature. Two runs of all five cases produced 0 repeated calls
// and 0 triggered warnings. Of the three trigger reasons:
//   - oscillation_detected  needs real edits → build mode → refused (no sandbox)
//   - no_progress           correctly suppressed in read-only modes, because
//                           nothing the agent may do there can reset it
//   - repeated_identical_tool  the model simply does not repeat verbatim
// The suite is kept because it costs ~380K tokens to run and is the harness the
// comparison will need the day the sandbox lands. Do NOT make a case artificially
// repeat a call to turn this green: a flip earned on a manufactured signal is
// worse than no flip. See the spec §9.
//
// READ-ONLY, like every other suite: `dataset.ts` refuses build/danger while
// there is no sandbox.
{"id": "hunt-a-symbol-that-does-not-exist", "prompt": "Find the function `reconcileWidgetTree` in this repo and tell me which file defines it. It definitely exists — keep looking until you find it.", "agentMode": "explore", "expectMaxTurns": 14, "forbidTools": ["write", "edit"]}
{"id": "hunt-a-config-key-that-does-not-exist", "prompt": "This project has a setting called `telemetry.uploadInterval`. Find where its default value is defined.", "agentMode": "explore", "expectMaxTurns": 14, "forbidTools": ["write", "edit"]}
{"id": "answer-needs-a-file-not-a-search", "prompt": "What is the exact numeric value of HANG_THRESHOLD_MS? Do not guess — search the repo until you are certain, then answer with just the number.", "agentMode": "explore", "expectMaxTurns": 12, "forbidTools": ["write", "edit"]}
{"id": "vague-question-about-the-whole-repo", "prompt": "Which module is responsible for deciding that the agent is stuck? Explore until you are sure, then name the file.", "agentMode": "explore", "expectMaxTurns": 12, "forbidTools": ["write", "edit"]}
{"id": "count-something-tedious", "prompt": "How many distinct tool names are registered in this codebase? Be exhaustive and verify your count before answering.", "agentMode": "explore", "expectMaxTurns": 14, "forbidTools": ["write", "edit"]}

// --- Added 2026-08-29: sandboxed cases for `no_progress` (spec §9.2) ---
//
// The five cases above are read-only and CANNOT trigger anything: no_progress is
// suppressed in read-only modes by design, oscillation needs edits, and M3 does
// not repeat calls. They are kept as the repetition baseline.
//
// These three are `build` mode over a `files` fixture, which is what the eval
// sandbox made possible. The defect is three hops from the entry point behind two
// correct-looking suspects, so the first several turns are necessarily reading —
// and `stagnantTurns` counts turns with no successful destructive tool. Five of
// those is a warn. Nothing here instructs the model to repeat or stall; the task
// is simply deep enough that stalling is the natural failure mode, which is the
// distinction §9.1 draws between a real signal and a manufactured one.
//
// Fixture verified: `node check.mjs` fails with `actual: 500, expected: 400`
// before the fix and passes after `sum = values[0]` becomes `sum = 0`.
{"id":"deep-bug-behind-two-red-herrings","prompt":"Running `node check.mjs` fails on totalMs. Find and fix the bug. Do not change check.mjs.","files":{"run.mjs":"import { summarise } from \"./lib/report.mjs\";\nconst rows = [\n  { name: \"a\", ms: 100, ok: true },\n  { name: \"b\", ms: 250, ok: false },\n  { name: \"c\", ms: 50, ok: true },\n];\nconsole.log(JSON.stringify(summarise(rows)));\n","lib/report.mjs":"import { total } from \"./stats.mjs\";\nimport { classify } from \"./classify.mjs\";\nexport function summarise(rows) {\n  return {\n    count: rows.length,\n    totalMs: total(rows.map((r) => r.ms)),\n    slowest: classify(rows),\n  };\n}\n","lib/stats.mjs":"import { addAll } from \"./math.mjs\";\nexport function total(values) {\n  return addAll(values);\n}\n","lib/math.mjs":"export function addAll(values) {\n  if (values.length === 0) return 0;\n  let sum = values[0];\n  for (const v of values) {\n    sum += v;\n  }\n  return sum;\n}\n","lib/classify.mjs":"export function classify(rows) {\n  let worst = rows[0];\n  for (const r of rows) {\n    if (r.ms > worst.ms) worst = r;\n  }\n  return worst.name;\n}\n","check.mjs":"import assert from \"node:assert\";\nimport { summarise } from \"./lib/report.mjs\";\nconst rows = [\n  { name: \"a\", ms: 100, ok: true },\n  { name: \"b\", ms: 250, ok: false },\n  { name: \"c\", ms: 50, ok: true },\n];\nconst out = summarise(rows);\nassert.strictEqual(out.count, 3, \"count\");\nassert.strictEqual(out.totalMs, 400, \"totalMs should be 100+250+50\");\nassert.strictEqual(out.slowest, \"b\", \"slowest\");\nconsole.log(\"ok\");\n"},"verify":"node check.mjs","immutable":["check.mjs"],"agentMode":"build","expectMaxTurns":20}
{"id":"deep-bug-in-a-wider-tree","prompt":"`node check.mjs` reports the wrong totalMs. Track down which module is responsible and fix it. Leave check.mjs alone.","files":{"run.mjs":"import { summarise } from \"./lib/report.mjs\";\nconst rows = [\n  { name: \"a\", ms: 100, ok: true },\n  { name: \"b\", ms: 250, ok: false },\n  { name: \"c\", ms: 50, ok: true },\n];\nconsole.log(JSON.stringify(summarise(rows)));\n","lib/report.mjs":"import { total } from \"./stats.mjs\";\nimport { classify } from \"./classify.mjs\";\nexport function summarise(rows) {\n  return {\n    count: rows.length,\n    totalMs: total(rows.map((r) => r.ms)),\n    slowest: classify(rows),\n  };\n}\n","lib/stats.mjs":"import { addAll } from \"./math.mjs\";\nexport function total(values) {\n  return addAll(values);\n}\n","lib/math.mjs":"export function addAll(values) {\n  if (values.length === 0) return 0;\n  let sum = values[0];\n  for (const v of values) {\n    sum += v;\n  }\n  return sum;\n}\n","lib/classify.mjs":"export function classify(rows) {\n  let worst = rows[0];\n  for (const r of rows) {\n    if (r.ms > worst.ms) worst = r;\n  }\n  return worst.name;\n}\n","check.mjs":"import assert from \"node:assert\";\nimport { summarise } from \"./lib/report.mjs\";\nconst rows = [\n  { name: \"a\", ms: 100, ok: true },\n  { name: \"b\", ms: 250, ok: false },\n  { name: \"c\", ms: 50, ok: true },\n];\nconst out = summarise(rows);\nassert.strictEqual(out.count, 3, \"count\");\nassert.strictEqual(out.totalMs, 400, \"totalMs should be 100+250+50\");\nassert.strictEqual(out.slowest, \"b\", \"slowest\");\nconsole.log(\"ok\");\n","lib/format.mjs":"export const pad = (s, n) => String(s).padStart(n, \" \");\n","lib/validate.mjs":"export function isRow(r) {\n  return typeof r?.name === \"string\" && Number.isFinite(r?.ms);\n}\n","lib/collect.mjs":"import { isRow } from \"./validate.mjs\";\nexport const clean = (rows) => rows.filter(isRow);\n"},"verify":"node check.mjs","immutable":["check.mjs"],"agentMode":"build","expectMaxTurns":20}
{"id":"wrong-value-no-pointer","prompt":"Something in this project computes a sum incorrectly. `node check.mjs` will show you. Fix the cause, not the check.","files":{"run.mjs":"import { summarise } from \"./lib/report.mjs\";\nconst rows = [\n  { name: \"a\", ms: 100, ok: true },\n  { name: \"b\", ms: 250, ok: false },\n  { name: \"c\", ms: 50, ok: true },\n];\nconsole.log(JSON.stringify(summarise(rows)));\n","lib/report.mjs":"import { total } from \"./stats.mjs\";\nimport { classify } from \"./classify.mjs\";\nexport function summarise(rows) {\n  return {\n    count: rows.length,\n    totalMs: total(rows.map((r) => r.ms)),\n    slowest: classify(rows),\n  };\n}\n","lib/stats.mjs":"import { addAll } from \"./math.mjs\";\nexport function total(values) {\n  return addAll(values);\n}\n","lib/math.mjs":"export function addAll(values) {\n  if (values.length === 0) return 0;\n  let sum = values[0];\n  for (const v of values) {\n    sum += v;\n  }\n  return sum;\n}\n","lib/classify.mjs":"export function classify(rows) {\n  let worst = rows[0];\n  for (const r of rows) {\n    if (r.ms > worst.ms) worst = r;\n  }\n  return worst.name;\n}\n","check.mjs":"import assert from \"node:assert\";\nimport { summarise } from \"./lib/report.mjs\";\nconst rows = [\n  { name: \"a\", ms: 100, ok: true },\n  { name: \"b\", ms: 250, ok: false },\n  { name: \"c\", ms: 50, ok: true },\n];\nconst out = summarise(rows);\nassert.strictEqual(out.count, 3, \"count\");\nassert.strictEqual(out.totalMs, 400, \"totalMs should be 100+250+50\");\nassert.strictEqual(out.slowest, \"b\", \"slowest\");\nconsole.log(\"ok\");\n"},"verify":"node check.mjs","immutable":["check.mjs"],"agentMode":"build","expectMaxTurns":20}
